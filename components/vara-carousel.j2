{% set container = props.container|default:"lg" %}
{% set background = props.background|default:"base-100" %}
{% set slides_per_view = props.slides_per_view|default:"1" %}
{% set show_controls = props.show_controls|default:"true" %}
{% set show_dots = props.show_dots|default:"true" %}
{% set label = props.label|default:"Carousel" %}
{% if container == "xs" %}{% set container_cls = "max-w-md" %}{% elif container == "sm" %}{% set container_cls = "max-w-3xl" %}{% elif container == "md" %}{% set container_cls = "max-w-6xl" %}{% elif container == "xl" %}{% set container_cls = "max-w-[120rem]" %}{% elif container == "full" %}{% set container_cls = "max-w-full" %}{% else %}{% set container_cls = "max-w-7xl" %}{% endif %}

<section class="not-prose bg-{{ background }} py-10 desk:py-20{% if props.class %} {{ props.class }}{% endif %}">
  <div class="mx-auto w-full {{ container_cls }} px-4">
    <div class="relative" x-data="varaCarousel" role="region" aria-roledescription="carousel" aria-label="{{ label }}">
      <div
        x-ref="track"
        class="vara-carousel-track flex gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory outline-none"
        data-slides-per-view="{{ slides_per_view }}"
        x-on:scroll.debounce.50ms="onScroll()"
        tabindex="0"
        aria-label="Slides"
      >
        {{ props.content|safe }}
      </div>

      <div class="mt-5 flex items-center gap-4{% if show_controls == 'true' %} justify-between{% else %} justify-center{% endif %}" x-cloak x-show="slides > 1">
        {% if show_dots == "true" %}
          <div class="flex items-center gap-1.5" role="tablist" aria-label="Choose slide">
            <template x-for="(i) in slides" :key="i">
              <button
                type="button"
                role="tab"
                class="size-2 cursor-pointer rounded-full transition-colors"
                :class="index === i ? 'bg-content' : 'bg-base-400 hover:bg-content-muted'"
                :aria-selected="index === i"
                :aria-label="'Go to slide ' + (i + 1)"
                x-on:click="scrollTo(i)"
              ></button>
            </template>
          </div>
        {% endif %}
        {% if show_controls == "true" %}
          <div class="flex items-center gap-2">
            <button
              type="button"
              class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md border border-base-400 bg-base-100 text-content outline-content transition-colors hover:bg-base-300 focus-visible:outline-2 disabled:cursor-not-allowed disabled:opacity-40"
              x-on:click="prev()"
              :disabled="index === 0"
              aria-label="Previous slide"
            >
              <span aria-hidden="true">{{ vara_icon("chevron-left", "size-4")|safe }}</span>
            </button>
            <button
              type="button"
              class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md border border-base-400 bg-base-100 text-content outline-content transition-colors hover:bg-base-300 focus-visible:outline-2 disabled:cursor-not-allowed disabled:opacity-40"
              x-on:click="next()"
              :disabled="index >= slides - 1"
              aria-label="Next slide"
            >
              <span aria-hidden="true">{{ vara_icon("chevron-right", "size-4")|safe }}</span>
            </button>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
