{% set size = props.size|default:"md" %}
{% set padding = props.padding|default:"true" %}
{% set align = props.align|default:"center" %}
{% if size == "xs" %}{% set container_cls = "max-w-md" %}{% elif size == "sm" %}{% set container_cls = "max-w-3xl" %}{% elif size == "md" %}{% set container_cls = "max-w-6xl" %}{% elif size == "lg" %}{% set container_cls = "max-w-7xl" %}{% elif size == "xl" %}{% set container_cls = "max-w-[120rem]" %}{% else %}{% set container_cls = "max-w-full" %}{% endif %}
{% if padding == "true" %}{% set pad_cls = "px-4" %}{% else %}{% set pad_cls = "" %}{% endif %}
{% if align == "left" %}{% set align_cls = "mr-auto" %}{% elif align == "right" %}{% set align_cls = "ml-auto" %}{% else %}{% set align_cls = "mx-auto" %}{% endif %}

<div class="w-full {{ container_cls }} {{ pad_cls }} {{ align_cls }}{% if props.class %} {{ props.class }}{% endif %}">
  {{ props.content|safe }}
</div>
