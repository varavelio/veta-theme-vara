{% import "../templates/vara/macros/component-layout.j2" component_container %}

{% set size = props.size|default:"md" %}
{% set padding = props.padding|default:"true" %}
{% set align = props.align|default:"center" %}
{% if padding == "true" %}
  {% set pad_cls = "px-4" %}
{% else %}
  {% set pad_cls = "" %}
{% endif %}

{% if align == "left" %}
  {% set align_cls = "mr-auto" %}
{% elif align == "right" %}
  {% set align_cls = "ml-auto" %}
{% else %}
  {% set align_cls = "mx-auto" %}
{% endif %}

<div class="w-full {{ component_container(size) }} {{ pad_cls }} {{ align_cls }}{% if props.class %} {{ props.class }}{% endif %}">
  {{ props.content|safe }}
</div>
