{% set color = props.color|default:"neutral" %}
{% set icon = props.icon|default:"" %}
{% set title = props.title|default:"" %}
{% set description = props.description|default:"" %}
{% set role = props.role|default:"" %}
{% set heading_level = props.heading_level|default:"3" %}
{% set base = "relative rounded-lg border p-4" %}
{% if color == "info" %}
  {% set color_cls = "border-info/40 bg-info/2 text-info" %}
  {% set default_icon = "info" %}
{% elif color == "success" %}
  {% set color_cls = "border-success/40 bg-success/2 text-success" %}
  {% set default_icon = "circle-check" %}
{% elif color == "warning" %}
  {% set color_cls = "border-warning/40 bg-warning/2 text-warning" %}
  {% set default_icon = "triangle-alert" %}
{% elif color == "error" %}
  {% set color_cls = "border-error/40 bg-error/2 text-error" %}
  {% set default_icon = "circle-x" %}
{% else %}
  {% set color_cls = "border-base-400 bg-base-200/2 text-content" %}
  {% set default_icon = "info" %}
{% endif %}
{% if icon %}
  {% set resolved_icon = icon %}
{% else %}
  {% set resolved_icon = default_icon %}
{% endif %}
{% set all = base + " " + color_cls %}
{% if props.class %}
  {% set all = all + " " + props.class %}
{% endif %}
<aside class="{{ all }}"{% if role == "alert" or role == "status" %} role="{{ role }}"{% endif %}>
  <div class="flex gap-3">
    <span class="mt-0.5 shrink-0" aria-hidden="true">{{ vara_icon(resolved_icon, "size-5")|safe }}</span>
    <div class="min-w-0 flex-1">
      {% if title %}
        {% if heading_level == "4" %}<h4 class="font-medium">{{ title }}</h4>{% else %}<h3 class="font-medium">{{ title }}</h3>{% endif %}
      {% endif %}
      {% if props.content %}<div class="text-sm leading-relaxed opacity-90{% if title %} mt-1{% endif %}">{{ props.content|safe }}</div>{% elif description %}<p class="text-sm leading-relaxed opacity-90{% if title %} mt-1{% endif %}">{{ description }}</p>{% endif %}
    </div>
  </div>
</aside>
