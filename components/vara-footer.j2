{% set container = props.container|default:"lg" %}
{% set links = props.links|default:"" %}
{% set link_items = links|split:"," %}
{% set show_credit = props.show_credit|default:"true" %}
{% set site_title = vara_site_setting("title")|default:"Vara" %}
{% set year = props.year|default:"" %}
{% if not year %}{% set year = vara_site_setting("year") %}{% endif %}
{% if container == "xs" %}{% set container_cls = "max-w-md" %}{% elif container == "sm" %}{% set container_cls = "max-w-3xl" %}{% elif container == "md" %}{% set container_cls = "max-w-6xl" %}{% elif container == "xl" %}{% set container_cls = "max-w-[120rem]" %}{% elif container == "full" %}{% set container_cls = "max-w-full" %}{% else %}{% set container_cls = "max-w-7xl" %}{% endif %}

<footer class="not-prose shrink-0 border-t border-base-400 bg-base-100{% if props.class %} {{ props.class }}{% endif %}">
  <div class="mx-auto w-full {{ container_cls }} px-4">
    <div class="flex flex-col gap-4 py-6 desk:flex-row desk:items-center desk:justify-between">
      <p class="max-w-2xl text-sm leading-6 text-content-muted">
        {% if props.copyright %}{{ props.copyright }}{% else %}&copy; {% if year %}{{ year }} {% endif %}{{ site_title }}.{% endif %}
        {% if show_credit != "false" %} Built with <a href="https://veta.varavel.com" class="rounded-sm font-medium text-content no-underline outline-content transition-colors hover:text-info focus-visible:outline-2 focus-visible:outline-offset-2">Veta</a> and <a href="https://github.com/varavelio/veta-theme-vara" class="rounded-sm font-medium text-content no-underline outline-content transition-colors hover:text-info focus-visible:outline-2 focus-visible:outline-offset-2">Vara</a>.{% endif %}
      </p>

      {% if links or props.github_href %}
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-2" aria-label="Footer navigation">
          {% for link in link_items %}
            {% set parts = link|vara_trim|split:"|" %}
            {% if parts|length == 2 %}<a href="{{ url(parts[1]|vara_trim) }}" class="rounded-sm text-sm font-medium text-content-muted no-underline outline-content transition-colors hover:text-content focus-visible:outline-2 focus-visible:outline-offset-2">{{ parts[0]|vara_trim }}</a>{% endif %}
          {% endfor %}
          {% if props.github_href %}<a href="{{ url(props.github_href) }}" class="rounded-sm text-content-muted outline-content transition-colors hover:text-content focus-visible:outline-2 focus-visible:outline-offset-2" target="_blank" rel="noopener noreferrer" aria-label="{{ props.github_label|default:'GitHub' }}"><span aria-hidden="true">{{ vara_icon("github", "size-5")|safe }}</span></a>{% endif %}
        </nav>
      {% endif %}
    </div>
  </div>
</footer>
