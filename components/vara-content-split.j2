{% import "../templates/vara/macros/button.j2" button %}

{% set container = props.container|default:"lg" %}
{% set background = props.background|default:"base-100" %}
{% set media_position = props.media_position|default:"end" %}
{% set has_media = props.image_src or props.panel_title or props.panel_description %}
{% if container == "xs" %}{% set container_cls = "max-w-md" %}{% elif container == "sm" %}{% set container_cls = "max-w-3xl" %}{% elif container == "md" %}{% set container_cls = "max-w-6xl" %}{% elif container == "xl" %}{% set container_cls = "max-w-[120rem]" %}{% elif container == "full" %}{% set container_cls = "max-w-full" %}{% else %}{% set container_cls = "max-w-7xl" %}{% endif %}

{% macro list_item(text) %}
  {% if text %}<li class="flex items-start gap-3"><span class="mt-1 shrink-0 text-content" aria-hidden="true">{{ vara_icon("check", "size-4")|safe }}</span><span>{{ text }}</span></li>{% endif %}
{% endmacro %}

<section class="not-prose bg-{{ background }} py-10 desk:py-20{% if props.class %} {{ props.class }}{% endif %}">
  <div class="mx-auto w-full {{ container_cls }} px-4">
    <div class="grid gap-8{% if has_media %} desk:grid-cols-2 desk:items-center desk:gap-12{% endif %}">
      <div class="min-w-0{% if media_position == 'start' and has_media %} desk:order-2{% endif %}">
        {% if props.eyebrow or props.title or props.description %}
          <div class="flex max-w-3xl flex-col gap-3 text-left">
            {% if props.eyebrow %}<p class="text-xs font-medium uppercase tracking-[0.24em] text-content-muted">{{ props.eyebrow }}</p>{% endif %}
            {% if props.title %}{% if props.heading_level == "3" %}<h3 class="text-3xl font-semibold tracking-tight text-content desk:text-4xl">{{ props.title }}</h3>{% else %}<h2 class="text-3xl font-semibold tracking-tight text-content desk:text-4xl">{{ props.title }}</h2>{% endif %}{% endif %}
            {% if props.description %}<p class="text-base leading-7 text-content-muted desk:text-lg">{{ props.description }}</p>{% endif %}
          </div>
        {% endif %}
        {% if props.item_1 or props.item_2 or props.item_3 or props.item_4 %}
          <ul class="mt-6 grid gap-3 text-sm leading-6 text-content-muted">
            {{ list_item(props.item_1) }}
            {{ list_item(props.item_2) }}
            {{ list_item(props.item_3) }}
            {{ list_item(props.item_4) }}
          </ul>
        {% endif %}
        {% if props.primary_label and props.primary_href %}
          <div class="mt-8 flex flex-col gap-3 desk:flex-row">
            {{ button(props.primary_label, props.primary_href, props.primary_target|default:"", props.primary_icon|default:"", "", "lg", "md", props.primary_variant|default:"solid", props.primary_color|default:"neutral", "true", "false", "button", "desk:w-auto") }}
            {% if props.secondary_label and props.secondary_href %}{{ button(props.secondary_label, props.secondary_href, props.secondary_target|default:"", props.secondary_icon|default:"", "", "lg", "md", props.secondary_variant|default:"outline", props.secondary_color|default:"neutral", "true", "false", "button", "desk:w-auto") }}{% endif %}
          </div>
        {% endif %}
      </div>

      {% if has_media %}
        <div class="min-w-0{% if media_position == 'start' %} desk:order-1{% endif %}">
          {% if props.image_src %}
            <img src="{{ url(props.image_src) }}" alt="{{ props.image_alt|default:'' }}" class="aspect-[4/3] w-full rounded-lg border border-base-400 object-cover" loading="lazy" decoding="async"{% if props.image_width %} width="{{ props.image_width }}"{% endif %}{% if props.image_height %} height="{{ props.image_height }}"{% endif %}>
          {% else %}
            <div class="rounded-lg border border-base-400 bg-base-200 p-6 desk:p-8">
              {% if props.panel_icon %}<div class="flex size-11 items-center justify-center rounded-lg bg-base-100" aria-hidden="true">{{ vara_icon(props.panel_icon, "size-5 text-content")|safe }}</div>{% endif %}
              {% if props.panel_title %}{% if props.heading_level == "3" %}<h4 class="{% if props.panel_icon %}mt-5 {% endif %}text-xl font-medium tracking-tight text-content desk:text-2xl">{{ props.panel_title }}</h4>{% else %}<h3 class="{% if props.panel_icon %}mt-5 {% endif %}text-xl font-medium tracking-tight text-content desk:text-2xl">{{ props.panel_title }}</h3>{% endif %}{% endif %}
              {% if props.panel_description %}<p class="mt-3 text-sm leading-6 text-content-muted desk:text-base">{{ props.panel_description }}</p>{% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
