{% set id = props.id|default:"" %}
{% set question = props.question|default:"" %}

<div class="border-b border-base-400 last:border-b-0" data-vara-faq-item="{{ id }}">
  <h3>
    <button
      type="button"
      id="vara-faq-trigger-{{ id }}"
      class="flex w-full cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left font-medium text-content outline-content transition-colors hover:bg-base-200/60 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 desk:px-6"
      x-on:click="toggle('{{ id }}')"
      x-bind:aria-expanded="openItem === '{{ id }}'"
      aria-controls="vara-faq-panel-{{ id }}"
    >
      <span>{{ question }}</span>
      <span class="shrink-0 text-content-muted transition-transform duration-200" x-bind:class="openItem === '{{ id }}' && 'rotate-180'" aria-hidden="true">{{ vara_icon("chevron-down", "size-5")|safe }}</span>
    </button>
  </h3>
  <div
    id="vara-faq-panel-{{ id }}"
    class="px-5 pb-5 pr-8 text-sm leading-7 text-content-muted desk:px-6 desk:text-base"
    x-show="openItem === '{{ id }}'"
    x-cloak
    aria-labelledby="vara-faq-trigger-{{ id }}"
  >
    {{ props.content|safe }}
  </div>
</div>
