{% comment %}
  Self-contained theme preference dropdown.

  Parameters:
    label - Visible and accessible trigger label
    class - Additional classes for positioning the picker wrapper
{% endcomment %}

{% macro theme_picker(label="Theme", class="") export %}
  <div class="contents" x-data="theme">
    <div
      class="relative{% if class %} {{ class }}{% endif %}"
      x-data="{ open: false }"
      x-id="['theme-picker-menu']"
      x-on:keydown.escape.prevent.stop="if (open) { open = false; $refs.trigger.focus(); }"
      x-on:focusin.window="if (open && !$el.contains($event.target)) open = false"
    >
      <button
        x-ref="trigger"
        type="button"
        class="relative inline-flex h-8 cursor-pointer select-none items-center gap-1.5 rounded-md bg-transparent px-2.5 text-sm font-medium text-content outline-content transition-colors hover:bg-base-300 focus-visible:outline-2"
        x-on:click="open = !open"
        x-on:keydown.arrow-down.prevent="open = true; $nextTick(() => $refs.system.focus())"
        x-on:keydown.arrow-up.prevent="open = true; $nextTick(() => $refs.dark.focus())"
        x-bind:aria-expanded="open.toString()"
        x-bind:aria-controls="$id('theme-picker-menu')"
        aria-haspopup="menu"
      >
        <span x-show="theme === 'system'" x-cloak>{{ vara_icon("laptop-minimal", "size-4 shrink-0")|safe }}</span>
        <span x-show="theme === 'light'" x-cloak>{{ vara_icon("sun-medium", "size-4 shrink-0")|safe }}</span>
        <span x-show="theme === 'dark'" x-cloak>{{ vara_icon("moon-star", "size-4 shrink-0")|safe }}</span>
        <span>{{ label }}</span>
      </button>

      <div
        x-ref="menu"
        x-bind:id="$id('theme-picker-menu')"
        x-show="open"
        x-cloak
        x-transition:enter="transition ease-out duration-100"
        x-transition:enter-start="opacity-0 translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-75"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 translate-y-1"
        x-on:click.outside="open = false"
        x-on:keydown.home.prevent="$refs.system.focus()"
        x-on:keydown.end.prevent="$refs.dark.focus()"
        class="absolute right-0 z-50 mt-2 max-h-[70dvh] min-w-56 max-w-[70dvw] origin-top-right overflow-auto rounded-lg border border-base-400 bg-base-100 p-1 shadow-sm"
        role="menu"
        aria-label="Theme preference"
      >
        <button
          x-ref="system"
          type="button"
          role="menuitemradio"
          class="flex w-full cursor-pointer select-none items-center gap-2 rounded-md px-3 py-2 text-left text-sm text-content outline-none hover:bg-base-300 focus:bg-base-300"
          x-bind:class="theme === 'system' && 'bg-base-200'"
          x-bind:aria-checked="(theme === 'system').toString()"
          x-on:click="setSystemTheme(); open = false; $refs.trigger.focus()"
          x-on:keydown.arrow-down.prevent="$refs.light.focus()"
          x-on:keydown.arrow-up.prevent="$refs.dark.focus()"
        >
          <span class="flex size-4 shrink-0 items-center justify-center">
            {{ vara_icon("laptop-minimal", "size-4")|safe }}
          </span>
          <span>System</span>
          <span class="ml-auto" x-show="theme === 'system'" x-cloak>
            {{ vara_icon("check", "size-4 text-content-muted")|safe }}
          </span>
        </button>
        <button
          x-ref="light"
          type="button"
          role="menuitemradio"
          class="flex w-full cursor-pointer select-none items-center gap-2 rounded-md px-3 py-2 text-left text-sm text-content outline-none hover:bg-base-300 focus:bg-base-300"
          x-bind:class="theme === 'light' && 'bg-base-200'"
          x-bind:aria-checked="(theme === 'light').toString()"
          x-on:click="setLightTheme(); open = false; $refs.trigger.focus()"
          x-on:keydown.arrow-down.prevent="$refs.dark.focus()"
          x-on:keydown.arrow-up.prevent="$refs.system.focus()"
        >
          <span class="flex size-4 shrink-0 items-center justify-center">
            {{ vara_icon("sun-medium", "size-4")|safe }}
          </span>
          <span>Light</span>
          <span class="ml-auto" x-show="theme === 'light'" x-cloak>
            {{ vara_icon("check", "size-4 text-content-muted")|safe }}
          </span>
        </button>
        <button
          x-ref="dark"
          type="button"
          role="menuitemradio"
          class="flex w-full cursor-pointer select-none items-center gap-2 rounded-md px-3 py-2 text-left text-sm text-content outline-none hover:bg-base-300 focus:bg-base-300"
          x-bind:class="theme === 'dark' && 'bg-base-200'"
          x-bind:aria-checked="(theme === 'dark').toString()"
          x-on:click="setDarkTheme(); open = false; $refs.trigger.focus()"
          x-on:keydown.arrow-down.prevent="$refs.system.focus()"
          x-on:keydown.arrow-up.prevent="$refs.light.focus()"
        >
          <span class="flex size-4 shrink-0 items-center justify-center">
            {{ vara_icon("moon-star", "size-4")|safe }}
          </span>
          <span>Dark</span>
          <span class="ml-auto" x-show="theme === 'dark'" x-cloak>
            {{ vara_icon("check", "size-4 text-content-muted")|safe }}
          </span>
        </button>
      </div>
    </div>
  </div>
{% endmacro %}
