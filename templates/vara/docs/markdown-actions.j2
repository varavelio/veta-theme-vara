<div
  class="relative shrink-0"
  x-data="{ open: false }"
  x-id="['ask-ai-menu']"
  x-on:keydown.escape.prevent.stop="if (open) { open = false; $refs.trigger.focus(); }"
  x-on:focusin.window="if (open && !$el.contains($event.target)) open = false"
  data-markdown-url="{{ markdown_url }}"
>
  <button
    x-ref="trigger"
    type="button"
    class="inline-flex h-8 cursor-pointer select-none items-center gap-1.5 rounded-md border border-base-400 bg-base-100 px-2.5 text-xs font-medium whitespace-nowrap text-content outline-content transition-colors hover:bg-base-200 focus-visible:outline-2"
    x-on:click="open = !open"
    x-on:keydown.arrow-down.prevent="open = true; $nextTick(() => $refs.chatgpt.focus())"
    x-bind:aria-expanded="open.toString()"
    x-bind:aria-controls="$id('ask-ai-menu')"
    aria-haspopup="menu"
  >
    {{ vara_icon("sparkles", "size-3.5 text-content-muted")|safe }}
    <span>Ask AI</span>
    <span class="text-content-muted transition-transform" x-bind:class="open && 'rotate-180'">
      {{ vara_icon("chevron-down", "size-3.5")|safe }}
    </span>
  </button>

  <div
    x-ref="menu"
    x-bind:id="$id('ask-ai-menu')"
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-100"
    x-transition:enter-start="opacity-0 translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-75"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-1"
    x-on:click.outside="open = false"
    x-on:keydown.home.prevent="$refs.chatgpt.focus()"
    x-on:keydown.end.prevent="$refs.download.focus()"
    class="absolute right-0 z-50 mt-2 max-h-[70dvh] w-72 max-w-[calc(100vw-2rem)] origin-top-right overflow-auto rounded-lg border border-base-400 bg-base-100 p-1 shadow-sm"
    role="menu"
    aria-label="Ask AI and Markdown actions"
  >
    <div class="px-2.5 pb-1.5 pt-2" role="presentation">
      <p class="text-xs font-semibold text-content">Ask AI about this page</p>
      <p class="mt-0.5 text-xs text-content-muted">Open the Markdown source of this page in your preferred AI assistant</p>
    </div>

    <a
      x-ref="chatgpt"
      x-bind:href="askAiUrl('chatgpt', $root.dataset.markdownUrl)"
      x-on:click="open = false"
      x-on:keydown.arrow-down.prevent="$refs.claude.focus()"
      x-on:keydown.arrow-up.prevent="$refs.download.focus()"
      class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-content outline-none transition-colors hover:bg-base-200 focus:bg-base-200"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
    >
      <span class="flex size-5 shrink-0 items-center justify-center text-content-muted">
        {{ vara_icon("sparkles", "size-4")|safe }}
      </span>
      <span>Ask ChatGPT</span>
    </a>
    <a
      x-ref="claude"
      x-bind:href="askAiUrl('claude', $root.dataset.markdownUrl)"
      x-on:click="open = false"
      x-on:keydown.arrow-down.prevent="$refs.grok.focus()"
      x-on:keydown.arrow-up.prevent="$refs.chatgpt.focus()"
      class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-content outline-none transition-colors hover:bg-base-200 focus:bg-base-200"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
    >
      <span class="flex size-5 shrink-0 items-center justify-center text-content-muted">
        {{ vara_icon("claude", "size-4")|safe }}
      </span>
      <span>Ask Claude</span>
    </a>
    <a
      x-ref="grok"
      x-bind:href="askAiUrl('grok', $root.dataset.markdownUrl)"
      x-on:click="open = false"
      x-on:keydown.arrow-down.prevent="$refs.perplexity.focus()"
      x-on:keydown.arrow-up.prevent="$refs.claude.focus()"
      class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-content outline-none transition-colors hover:bg-base-200 focus:bg-base-200"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
    >
      <span class="flex size-5 shrink-0 items-center justify-center text-content-muted">
        {{ vara_icon("si-x", "size-4")|safe }}
      </span>
      <span>Ask Grok</span>
    </a>
    <a
      x-ref="perplexity"
      x-bind:href="askAiUrl('perplexity', $root.dataset.markdownUrl)"
      x-on:click="open = false"
      x-on:keydown.arrow-down.prevent="$refs.deepseek.focus()"
      x-on:keydown.arrow-up.prevent="$refs.grok.focus()"
      class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-content outline-none transition-colors hover:bg-base-200 focus:bg-base-200"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
    >
      <span class="flex size-5 shrink-0 items-center justify-center text-content-muted">
        {{ vara_icon("perplexity", "size-4")|safe }}
      </span>
      <span>Ask Perplexity</span>
    </a>
    <a
      x-ref="deepseek"
      x-bind:href="askAiUrl('deepseek', $root.dataset.markdownUrl)"
      x-on:click="open = false"
      x-on:keydown.arrow-down.prevent="$refs.copyPrompt.disabled ? $refs.copyMarkdown.focus() : $refs.copyPrompt.focus()"
      x-on:keydown.arrow-up.prevent="$refs.perplexity.focus()"
      class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-content outline-none transition-colors hover:bg-base-200 focus:bg-base-200"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
    >
      <span class="flex size-5 shrink-0 items-center justify-center text-content-muted">
        {{ vara_icon("deepseek", "size-4")|safe }}
      </span>
      <span>Ask DeepSeek</span>
    </a>

    <button
      x-ref="copyPrompt"
      type="button"
      class="flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm font-medium text-content outline-none transition-colors hover:bg-base-200 focus:bg-base-200 disabled:cursor-wait disabled:opacity-70"
      x-bind:disabled="promptCopyUi.disabled"
      x-on:click="copyAskAiPrompt($root.dataset.markdownUrl)"
      x-on:keydown.arrow-down.prevent="$refs.copyMarkdown.focus()"
      x-on:keydown.arrow-up.prevent="$refs.deepseek.focus()"
      role="menuitem"
    >
      <span class="flex size-5 shrink-0 items-center justify-center" x-show="promptCopyUi.icon === 'copy'">
        {{ vara_icon("copy", "size-4 text-content-muted")|safe }}
      </span>
      <span class="flex size-5 shrink-0 items-center justify-center" x-show="promptCopyUi.icon === 'check'">
        {{ vara_icon("check", "size-4 text-success")|safe }}
      </span>
      <span aria-live="polite" x-text="promptCopyUi.label">Copy Prompt</span>
    </button>

    <div class="my-1 border-t border-base-400" role="separator"></div>

    <button
      x-ref="copyMarkdown"
      type="button"
      class="flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-2 text-left text-sm font-medium text-content outline-none transition-colors hover:bg-base-200 focus:bg-base-200 disabled:cursor-wait disabled:opacity-70"
      x-bind:disabled="markdownCopyUi.disabled"
      x-on:click="copyMarkdown($root.dataset.markdownUrl)"
      x-on:keydown.arrow-down.prevent="$refs.view.focus()"
      x-on:keydown.arrow-up.prevent="$refs.copyPrompt.disabled ? $refs.deepseek.focus() : $refs.copyPrompt.focus()"
      role="menuitem"
    >
      <span class="flex size-5 shrink-0 items-center justify-center" x-show="markdownCopyUi.icon === 'copy'">
        {{ vara_icon("copy", "size-4 text-content-muted")|safe }}
      </span>
      <span class="flex size-5 shrink-0 items-center justify-center" x-show="markdownCopyUi.icon === 'check'">
        {{ vara_icon("check", "size-4 text-success")|safe }}
      </span>
      <span aria-live="polite" x-text="markdownCopyUi.label">Copy Markdown</span>
    </button>
    <a
      x-ref="view"
      href="{{ markdown_url }}"
      x-on:click="open = false"
      x-on:keydown.arrow-down.prevent="$refs.download.focus()"
      x-on:keydown.arrow-up.prevent="$refs.copyMarkdown.disabled ? ($refs.copyPrompt.disabled ? $refs.deepseek.focus() : $refs.copyPrompt.focus()) : $refs.copyMarkdown.focus()"
      class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-content outline-none transition-colors hover:bg-base-200 focus:bg-base-200"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
    >
      <span class="flex size-5 shrink-0 items-center justify-center">
        {{ vara_icon("eye", "size-4 text-content-muted")|safe }}
      </span>
      <span>View Markdown</span>
    </a>
    <a
      x-ref="download"
      href="{{ markdown_url }}"
      x-on:click="open = false"
      x-on:keydown.arrow-down.prevent="$refs.chatgpt.focus()"
      x-on:keydown.arrow-up.prevent="$refs.view.focus()"
      class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-content outline-none transition-colors hover:bg-base-200 focus:bg-base-200"
      download
      role="menuitem"
    >
      <span class="flex size-5 shrink-0 items-center justify-center">
        {{ vara_icon("download", "size-4 text-content-muted")|safe }}
      </span>
      <span>Download Markdown</span>
    </a>
  </div>
</div>
