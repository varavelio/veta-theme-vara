{% import "../macros/theme-picker.j2" theme_picker %}
{% import "../macros/github-button.j2" github_button %}
{% import "../macros/kbd.j2" kbd %}

<header class="h-14 shrink-0 border-b border-base-400 bg-base-100">
  <div class="mx-auto flex h-full max-w-[80rem] items-center justify-between gap-2 px-4 desk:gap-3">
    <div class="flex min-w-0 flex-1 items-center justify-start desk:flex-initial">
      <button
        class="-ml-2 mr-2 flex-none cursor-pointer rounded-md p-2 transition-colors hover:bg-base-300 desk:hidden"
        x-on:click="toggleSidebar()"
        aria-label="Toggle navigation"
      >
        {{ vara_icon("menu")|safe }}
      </button>
      <div class="min-w-0 flex-1 overflow-hidden">
        <a href="{{ url('/') }}" class="group flex min-w-0 items-center justify-start overflow-hidden whitespace-nowrap">
          {% if docs_logo_light and docs_logo_dark and docs_logo_light == docs_logo_dark %}
            <span class="mr-2 flex h-6 min-w-0 shrink items-center overflow-hidden">
              <img src="{{ docs_logo_light }}" class="h-6 w-auto max-w-full object-contain" alt="{{ site_title }}">
            </span>
          {% elif docs_logo_light or docs_logo_dark %}
            {% set logo_light_src = docs_logo_light|default:docs_logo_dark %}
            {% set logo_dark_src = docs_logo_dark|default:docs_logo_light %}
            <span class="mr-2 flex h-6 min-w-0 shrink items-center overflow-hidden" x-data="theme">
              <img
                x-show="resolvedTheme === 'light'"
                src="{{ logo_light_src }}"
                class="h-6 w-auto max-w-full object-contain"
                alt="{{ site_title }}"
              >
              <img
                x-show="resolvedTheme === 'dark'"
                src="{{ logo_dark_src }}"
                class="h-6 w-auto max-w-full object-contain"
                alt="{{ site_title }}"
              >
            </span>
          {% endif %}
          {% if docs_show_title %}
            <span class="min-w-0 truncate font-semibold text-content transition-colors group-hover:text-info">
              {{ site_title }}
            </span>
          {% endif %}
        </a>
      </div>
    </div>

    {% if docs_search %}
      <div class="hidden min-w-40 max-w-xs flex-1 px-2 desk:block">
        <button
          type="button"
          x-on:click="$dispatch('vara-search-open')"
          x-on:mouseenter="$dispatch('vara-search-preload')"
          x-on:focus="$dispatch('vara-search-preload')"
          class="flex h-8 w-full cursor-text items-center gap-2 rounded-md border border-base-400 bg-base-100 px-2.5 text-sm text-content-muted outline-content transition-colors hover:bg-base-200 hover:text-content focus-visible:outline-2"
          aria-label="Search documentation"
        >
          {{ vara_icon("search", "size-4 shrink-0")|safe }}
          <span class="min-w-0 flex-1 truncate text-left">Search documentation</span>
          {{ kbd("Ctrl K", "sm", "shrink-0") }}
        </button>
      </div>
    {% endif %}

    <div class="flex shrink-0 items-center justify-end gap-0 desk:min-w-0 desk:flex-1 desk:gap-2">
      {% if docs_search %}
        <button
          type="button"
          x-on:click="$dispatch('vara-search-open')"
          x-on:focus="$dispatch('vara-search-preload')"
          class="inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md text-content outline-content transition-colors hover:bg-base-300 focus-visible:outline-2 desk:hidden"
          aria-label="Search documentation"
        >
          {{ vara_icon("search", "size-4")|safe }}
        </button>
      {% endif %}
      {% if docs_header_links and docs_header_links|length > 0 %}
        <nav class="hidden min-w-0 flex-1 overflow-x-auto overflow-y-hidden desk:block" aria-label="Documentation links">
          <div class="ml-auto flex w-max items-center gap-1">
            {% for link in docs_header_links %}
              {% if link.title and link.href %}
                <a
                  href="{{ url(link.href) }}"
                  {% if link.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                  class="inline-flex h-8 items-center gap-1.5 rounded-md bg-transparent px-2.5 text-sm font-medium whitespace-nowrap text-content outline-content transition-colors hover:bg-base-300 focus-visible:outline-2"
                >
                  {% if link.icon %}{{ vara_icon(link.icon, "size-4 shrink-0")|safe }}{% endif %}
                  <span>{{ link.title }}</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </nav>
      {% endif %}
      {% if docs_github_repo %}
        <div class="hidden desk:block">
          {{ github_button(docs_github_repo) }}
        </div>
      {% endif %}
      {{ theme_picker("Theme") }}
    </div>
  </div>
</header>
