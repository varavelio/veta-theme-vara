{% import "../macros/theme-picker.j2" theme_picker %}

<header class="h-14 shrink-0 border-b border-base-400 bg-base-100">
  <div class="mx-auto flex h-full max-w-[80rem] items-center justify-between gap-3 px-4">
    <div class="flex min-w-0 flex-auto items-center justify-start">
      <button
        class="-ml-2 mr-2 flex-none cursor-pointer rounded-md p-2 transition-colors hover:bg-base-300 desk:hidden"
        x-on:click="toggleSidebar()"
        aria-label="Toggle navigation"
      >
        {{ vara_icon("menu")|safe }}
      </button>
      <div class="min-w-0 overflow-x-auto overflow-y-hidden">
        <a href="{{ url('/') }}" class="group flex items-center justify-start whitespace-nowrap">
          {% if docs_logo_light and docs_logo_dark and docs_logo_light == docs_logo_dark %}
            <span class="mr-2 flex-none h-6">
              <img src="{{ docs_logo_light }}" class="h-6 w-auto" alt="{{ site_title }}">
            </span>
          {% elif docs_logo_light or docs_logo_dark %}
            {% set logo_light_src = docs_logo_light|default:docs_logo_dark %}
            {% set logo_dark_src = docs_logo_dark|default:docs_logo_light %}
            <span class="mr-2 flex-none h-6" x-data="theme">
              <img
                x-show="resolvedTheme === 'light'"
                src="{{ logo_light_src }}"
                class="h-6 w-auto"
                alt="{{ site_title }}"
              >
              <img
                x-show="resolvedTheme === 'dark'"
                src="{{ logo_dark_src }}"
                class="h-6 w-auto"
                alt="{{ site_title }}"
              >
            </span>
          {% endif %}
          {% if docs_show_title %}
            <span class="font-semibold text-content transition-colors group-hover:text-info">
              {{ site_title }}
            </span>
          {% endif %}
        </a>
      </div>
    </div>

    <div class="flex flex-none items-center gap-2">
      {% if docs_header_links and docs_header_links|length > 0 %}
        <nav class="hidden items-center gap-1 desk:flex" aria-label="Documentation links">
          {% for link in docs_header_links %}
            {% if link.title and link.href %}
              <a
                href="{{ url(link.href) }}"
                {% if link.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                class="inline-flex h-8 items-center gap-1.5 rounded-md px-2.5 text-sm font-medium whitespace-nowrap text-content-muted transition-colors hover:bg-base-200 hover:text-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-content"
              >
                {% if link.icon %}{{ vara_icon(link.icon, "size-4 shrink-0")|safe }}{% endif %}
                <span>{{ link.title }}</span>
              </a>
            {% endif %}
          {% endfor %}
        </nav>
      {% endif %}
      {% if docs_github_repo %}
        <a
          href="https://github.com/{{ docs_github_repo }}"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden items-center gap-2 rounded-md border border-base-400 px-3 py-1.5 text-sm font-medium text-content transition-colors hover:bg-base-300 desk:flex"
        >
          {{ vara_icon("github", "size-4")|safe }}
          <span>GitHub</span>
        </a>
      {% endif %}
      {{ theme_picker("Theme") }}
    </div>
  </div>
</header>
