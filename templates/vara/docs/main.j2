{% extends "../base/main.j2" %}

{% block favicon %}
  {% set docs_favicon = vara_site_setting("docs_favicon", "favicon") %}
  {% if docs_favicon %}
    <link rel="shortcut icon" href="{{ docs_favicon }}">
  {% endif %}
{% endblock %}

{% block head_extra %}
  <script src="{{ url('/_vara/js/build/docs.js') }}" defer></script>
{% endblock %}

{% block body %}
  {% set docs_logo_light = vara_site_setting("docs_logo_light", "logo_light") %}
  {% set docs_logo_dark = vara_site_setting("docs_logo_dark", "logo_dark") %}
  {% set docs_show_title = vara_site_setting("docs_show_title") %}
  {% set docs_github_repo = vara_site_setting("docs_github_repo") %}
  {% set docs_header_links = vara_site_setting("docs_header_links") %}
  {% set docs_sidebar_sections = vara_site_setting("docs_sidebar_sections") %}
  {% set docs_sidebar_collapsed = vara_site_setting("docs_sidebar_collapsed") %}
  {% set docs_llms = vara_site_setting("docs_llms") %}
  {% set docs_shiki = vara_site_setting("docs_shiki") %}
  {% set docs_shiki_custom_languages = vara_site_setting("docs_shiki_custom_languages") %}
  {% set site_title = vara_site_setting("title") %}
  {% set page_path_parts = page.permalink|split:"/" %}
  {% set docs_root_permalink = "/" + page_path_parts[1] + "/" %}
  {% set docs_sidebar = vara_docs_sidebar_navigation(docs_root_permalink, docs_sidebar_sections) %}

  {% if docs_shiki %}
    <template id="vara-shiki-config">
      {% for language in docs_shiki_custom_languages %}
        {% if language.id and language.url %}
          <span data-language-id="{{ language.id }}" data-language-url="{{ language.url }}"></span>
        {% endif %}
      {% endfor %}
    </template>
  {% endif %}

  <div class="flex h-dvh flex-col" x-data="varapressDocs" x-cloak>
    {% include "./header.j2" %}

    <div class="relative isolate flex min-h-0 flex-1 justify-center">
      <div
        class="pointer-events-none absolute inset-y-0 left-0 z-0 hidden bg-base-200 desk:block"
        style="right: calc(50% + 16rem)"
      >
      </div>

      <div class="relative isolate flex min-h-0 min-w-0 w-full max-w-[80rem] flex-1">
        <aside class="hidden w-64 shrink-0 flex-col border-r border-base-400 desk:flex">
          <nav
            class="flex-1 min-h-0 space-y-1 overflow-y-auto p-4 pb-12"
            aria-label="Documentation"
            x-init='$nextTick(() => initSidebarScroll($el, "{{ page.permalink }}"))'
          >
            {% include "./sidebar.j2" %}
          </nav>
        </aside>

        <div class="desk:hidden">
          <div
            class="fixed inset-0 z-30 isolate bg-black/50"
            x-show="sidebarOpen"
            x-transition.opacity.duration.200
            x-on:click="toggleSidebar()"
            aria-hidden="true"
          >
          </div>
          <aside
            class="fixed inset-y-0 left-0 z-40 flex w-64 max-w-[80vw] isolate flex-col border-r border-base-400 bg-base-200"
            x-show="sidebarOpen"
            x-transition:enter="-translate-x-full"
            x-transition:enter-end="translate-x-0"
            x-transition:leave="translate-x-0"
            x-transition:leave-end="-translate-x-full"
            aria-label="Documentation navigation"
          >
            <div class="flex items-center justify-between border-b border-base-400 p-4">
              <span class="text-sm font-semibold text-content">Navigation</span>
              <button
                class="cursor-pointer rounded-md p-1.5 transition-colors hover:bg-base-300"
                x-on:click="toggleSidebar()"
                aria-label="Close navigation"
              >
                {{ vara_icon("x", "size-5")|safe }}
              </button>
            </div>
            <nav
              class="flex-1 min-h-0 space-y-1 overflow-y-auto p-4 pb-12"
              x-effect='sidebarOpen && $nextTick(() => initSidebarScroll($el, "{{ page.permalink }}"))'
            >
              {% include "./sidebar.j2" %}
              {% if docs_header_links and docs_header_links|length > 0 %}
                <div class="mt-4 space-y-1 border-t border-base-400 pt-4">
                  {% for link in docs_header_links %}
                    {% if link.title and link.href %}
                      <a
                        href="{{ url(link.href) }}"
                        {% if link.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                        class="flex items-center gap-2 rounded-md border border-transparent p-2 text-sm font-medium text-content/70 transition-colors hover:bg-base-300 hover:text-content"
                      >
                        {% if link.icon %}{{ vara_icon(link.icon, "size-4 shrink-0")|safe }}{% endif %}
                        <span class="flex-1 truncate">{{ link.title }}</span>
                        {% if link.new_tab %}{{ vara_icon("external-link", "size-3.5 shrink-0 text-content-muted")|safe }}{% endif %}
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            </nav>
          </aside>
        </div>

        {% include "./content.j2" %}
        {% include "./toc.j2" %}
      </div>
    </div>
  </div>
{% endblock %}
