<main class="flex-1 min-w-0 min-h-0 overflow-y-auto scroll-smooth bg-base-100 p-4 scroll-p-4 not-desk:pb-20 desk:px-8">
  {% set ancestors = vara_docs_breadcrumb_ancestors() %}

  <div class="mb-6 flex min-w-0 items-center gap-2">
    <nav
      class="flex min-w-0 flex-1 flex-nowrap items-center gap-1.5 overflow-x-auto text-sm whitespace-nowrap text-content-muted"
      aria-label="Breadcrumb"
    >
      {% for ancestor in ancestors %}
        {% if ancestor.content|vara_trim %}
          <a href="{{ url(ancestor.permalink) }}" class="shrink-0 transition-colors hover:text-content">
            {{ ancestor.title }}
          </a>
        {% else %}
          <span class="shrink-0">{{ ancestor.title }}</span>
        {% endif %}
        {{ vara_icon("chevron-right", "size-4 shrink-0 text-content-muted")|safe }}
      {% endfor %}
      <span
        class="inline-flex shrink-0 items-center gap-1.5 font-medium text-content"
        x-data
        x-init="$nextTick(() => $el.scrollIntoView({ block: 'nearest', inline: 'end' }))"
      >
        {{ page.title }}
      </span>
    </nav>

    <div class="flex shrink-0 items-center gap-1.5">
      <button
        type="button"
        class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md border border-base-400 bg-base-100 text-content outline-content transition-colors hover:bg-base-200 focus-visible:outline-2 wide:hidden"
        x-cloak
        x-show="tocAvailable"
        x-on:click="toggleToc()"
        aria-label="Table of contents"
      >
        {{ vara_icon("list", "size-4")|safe }}
      </button>
      {% if docs_llms %}
        {% set markdown_url = url(page.permalink + "index.md") %}
        {% include "./markdown-actions.j2" %}
      {% endif %}
    </div>
  </div>

  {% if page.content|vara_trim %}
    <article class="prose dark:prose-invert max-w-none{% if docs_shiki %} vara-shiki-enabled{% endif %}">
      {{ page.content|safe }}
    </article>

    {% set docs_footer_links = vara_docs_footer_links(page.docs_footer_links) %}
    {% include "./footer-links.j2" %}
    {% include "./pagination.j2" %}
  {% endif %}

  <button
    type="button"
    class="fixed bottom-4 left-1/2 z-30 inline-flex -translate-x-1/2 cursor-pointer items-center gap-2 rounded-full border border-base-400 bg-content px-3.5 py-2 text-sm font-medium text-base-100 shadow-sm transition hover:bg-content/90 desk:bottom-6"
    x-cloak
    x-show="showBackToTop"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-2 scale-95"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
    x-transition:leave-end="opacity-0 translate-y-2 scale-95"
    x-on:click="scrollMainToTop()"
    aria-label="Back to top"
  >
    {{ vara_icon("arrow-up-to-line", "size-4")|safe }}
    <span>Back to top</span>
  </button>
</main>
