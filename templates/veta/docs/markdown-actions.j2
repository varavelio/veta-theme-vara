<div class="not-prose -mt-4 mb-8 flex justify-start">
  <div
    class="relative"
    x-data="{ open: false }"
    x-on:click.outside="open = false"
    x-on:keydown.escape.window="open = false"
    data-markdown-url="{{ markdown_url }}"
  >
    <button
      type="button"
      class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-md border border-base-400 bg-base-100 px-3 text-sm font-medium text-content transition-colors hover:bg-base-200"
      x-on:click="open = !open"
      aria-haspopup="menu"
      x-bind:aria-expanded="open.toString()"
    >
      {{ icon("file-text", "size-4 text-content-muted")|safe }}
      <span>Markdown</span>
      <span class="text-content-muted transition-transform" x-bind:class="open && 'rotate-180'">
        {{ icon("chevron-down", "size-4")|safe }}
      </span>
    </button>

    <div
      class="absolute left-0 z-20 mt-2 w-56 rounded-lg border border-base-400 bg-base-100 p-1 shadow-sm"
      x-cloak
      x-show="open"
      x-transition:enter="transition ease-out duration-100"
      x-transition:enter-start="opacity-0 translate-y-1"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-75"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-1"
      role="menu"
    >
      <button
        type="button"
        class="flex w-full cursor-pointer items-center gap-2 rounded-md px-2.5 py-2 text-left text-sm font-medium text-content transition-colors hover:bg-base-200 disabled:cursor-wait disabled:opacity-70"
        x-bind:disabled="markdownCopyUi.disabled"
        x-on:click="copyMarkdown($root.dataset.markdownUrl); open = false"
        role="menuitem"
      >
        <span x-show="markdownCopyUi.icon === 'copy'">
          {{ icon("copy", "size-4 text-content-muted")|safe }}
        </span>
        <span x-show="markdownCopyUi.icon === 'check'">
          {{ icon("check", "size-4 text-success")|safe }}
        </span>
        <span aria-live="polite" x-text="markdownCopyUi.label">Copy Markdown</span>
      </button>
      <a
        href="{{ markdown_url }}"
        class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm font-medium text-content transition-colors hover:bg-base-200"
        target="_blank"
        rel="noopener noreferrer"
        role="menuitem"
      >
        {{ icon("eye", "size-4 text-content-muted")|safe }}
        <span>View Markdown</span>
      </a>
      <a
        href="{{ markdown_url }}"
        class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm font-medium text-content transition-colors hover:bg-base-200"
        download
        role="menuitem"
      >
        {{ icon("download", "size-4 text-content-muted")|safe }}
        <span>Download Markdown</span>
      </a>
    </div>
  </div>
</div>
