{% for item in pages %}
  {% if item.template == "veta/docs" and item.permalink == docs_root_permalink %}
    <div class="-mt-1.5">
      <a
        href="{{ url(item.permalink) }}"
        class="flex items-center gap-2 rounded-md border border-transparent p-2 text-sm font-medium transition-colors{% if page.permalink == item.permalink %} bg-info/10 text-info{% else %} text-content/70 hover:bg-base-300 hover:text-content{% endif %}"
        {% if page.permalink == item.permalink %}aria-current="page"{% endif %}
      >
        {% if item.icon %}{{ icon(item.icon, "size-4 shrink-0")|safe }}{% endif %}
        <span class="truncate">{{ item.title }}</span>
      </a>
    </div>
  {% endif %}
{% endfor %}

{% for item in pages %}
  {% set item_parts = item.permalink|split:"/" %}
  {% set item_content = item.content|trim %}
  {% if item.template == "veta/docs" and item.permalink != docs_root_permalink and item_parts|length == 4 %}
    <div x-data='varapressSidebarGroup("section:{{ item.permalink }}", {{ docs_sidebar_collapsed|lower }})' class="flex flex-col space-y-1">
      <div class="flex items-center gap-1">
        {% if item_content %}
          <a
            href="{{ url(item.permalink) }}"
            class="flex min-w-0 flex-1 items-center gap-2 rounded-md border border-transparent p-2 text-sm font-medium transition-colors{% if page.permalink == item.permalink %} bg-info/10 text-info{% else %} text-content/70 hover:bg-base-300 hover:text-content{% endif %}"
            {% if page.permalink == item.permalink %}aria-current="page"{% endif %}
          >
            {% if item.icon %}{{ icon(item.icon, "size-4 shrink-0")|safe }}{% endif %}
            <span class="truncate">{{ item.title }}</span>
          </a>
          <button
            type="button"
            x-show="$root.querySelector('[data-doc-child]')"
            x-on:click="toggle()"
            class="flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md text-content/70 transition-colors hover:bg-base-300 hover:text-content"
            x-bind:aria-expanded="open.toString()"
            aria-label="Toggle {{ item.title }} section"
          >
            <span class="transition-transform duration-200" x-bind:class="open && 'rotate-90'">
              {{ icon("chevron-right", "size-4")|safe }}
            </span>
          </button>
        {% else %}
          <button
            type="button"
            x-on:click="toggle()"
            class="flex w-full cursor-pointer items-center gap-2 rounded-md border border-transparent p-2 text-left text-sm font-medium text-content/70 transition-colors hover:bg-base-300 hover:text-content"
            x-bind:aria-expanded="open.toString()"
          >
            {% if item.icon %}{{ icon(item.icon, "size-4 shrink-0")|safe }}{% endif %}
            <span class="flex-1 truncate">{{ item.title }}</span>
            <span class="shrink-0 transition-transform duration-200" x-bind:class="open && 'rotate-90'">
              {{ icon("chevron-right", "size-4")|safe }}
            </span>
          </button>
        {% endif %}
      </div>
      <div
        x-show="open"
        x-transition
        class="tree-line-v after:h-[calc(100%-1.125rem)] mt-1 ml-4 flex flex-col space-y-1 pl-3.5"
      >
        {% for child in pages %}
          {% set child_parts = child.permalink|split:"/" %}
          {% set child_content = child.content|trim %}
          {% if child.template == "veta/docs" and child_content and child_parts|length == 5 and child_parts[2] == item_parts[2] %}
            <div class="tree-line-h min-w-0">
              <a
                data-doc-child
                href="{{ url(child.permalink) }}"
                class="flex items-center gap-2 rounded-md border border-transparent p-2 text-sm font-medium transition-colors{% if page.permalink == child.permalink %} bg-info/10 text-info{% else %} text-content/70 hover:bg-base-300 hover:text-content{% endif %}"
                {% if page.permalink == child.permalink %}aria-current="page"{% endif %}
              >
                {% if child.icon %}{{ icon(child.icon, "size-4 shrink-0")|safe }}{% endif %}
                <span class="truncate">{{ child.title }}</span>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
{% endfor %}

{% if docs_sidebar_links and docs_sidebar_links|length > 0 %}
  <div x-data='varapressSidebarGroup("links", {{ docs_sidebar_collapsed|lower }})' class="flex flex-col space-y-1">
    <button
      type="button"
      x-on:click="toggle()"
      class="flex w-full cursor-pointer items-center gap-2 rounded-md border border-transparent p-2 text-left text-sm font-medium text-content/70 transition-colors hover:bg-base-300 hover:text-content"
      x-bind:aria-expanded="open.toString()"
    >
      {{ icon("link", "size-4 shrink-0")|safe }}
      <span class="flex-1 truncate">Links</span>
      <span class="flex-none transition-transform duration-200" x-bind:class="open && 'rotate-90'">
        {{ icon("chevron-right", "size-4 shrink-0")|safe }}
      </span>
    </button>
    <div
      x-show="open"
      x-transition
      class="tree-line-v after:h-[calc(100%-1.125rem)] mt-1 ml-4 flex flex-col space-y-1 pl-3.5"
    >
      {% for link in docs_sidebar_links %}
        <div class="tree-line-h min-w-0">
          <a
            href="{{ link.link }}"
            {% if link.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            class="flex items-center gap-2 rounded-md border border-transparent p-2 text-sm font-medium text-content/70 transition-colors hover:bg-base-300 hover:text-content"
          >
            <span class="flex-1 truncate">{{ link.text }}</span>
            {% if link.new_tab %}{{ icon("external-link", "size-3.5 shrink-0 text-content-muted")|safe }}{% endif %}
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}

{% if docs_llms %}
  <div x-data='varapressSidebarGroup("agents", {{ docs_sidebar_collapsed|lower }})' class="flex flex-col space-y-1">
    <button
      type="button"
      x-on:click="toggle()"
      class="flex w-full cursor-pointer items-center gap-2 rounded-md border border-transparent p-2 text-left text-sm font-medium text-content/70 transition-colors hover:bg-base-300 hover:text-content"
      x-bind:aria-expanded="open.toString()"
    >
      {{ icon("bot", "size-4 shrink-0")|safe }}
      <span class="flex-1 truncate">Agents</span>
      <span class="flex-none transition-transform duration-200" x-bind:class="open && 'rotate-90'">
        {{ icon("chevron-right", "size-4 shrink-0")|safe }}
      </span>
    </button>
    <div
      x-show="open"
      x-transition
      class="tree-line-v after:h-[calc(100%-1.125rem)] mt-1 ml-4 flex flex-col space-y-1 pl-3.5"
    >
      <div class="tree-line-h min-w-0">
        <a
          href="{{ url(docs_root_permalink + 'llms.txt') }}"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-md border border-transparent p-2 text-sm font-medium text-content/70 transition-colors hover:bg-base-300 hover:text-content"
        >
          <span class="flex-1 truncate">llms.txt</span>
          {{ icon("external-link", "size-3.5 shrink-0 text-content-muted")|safe }}
        </a>
      </div>
      <div class="tree-line-h min-w-0">
        <a
          href="{{ url(docs_root_permalink + 'llms-full.txt') }}"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-md border border-transparent p-2 text-sm font-medium text-content/70 transition-colors hover:bg-base-300 hover:text-content"
        >
          <span class="flex-1 truncate">llms-full.txt</span>
          {{ icon("external-link", "size-3.5 shrink-0 text-content-muted")|safe }}
        </a>
      </div>
    </div>
  </div>
{% endif %}
